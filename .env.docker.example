# Salin menjadi .env di folder proyek, lalu isi yang bertanda GANTI
APP_NAME="Jaya POS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # GANTI: docker compose run --rm app php artisan key:generate --show
APP_URL=http://localhost:8000 # GANTI saat online: https://api.domainmu.com
JAYA_CONTACT_EMAIL=emailmu@domain.com

# Database (container "db" di compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=jaya_pos
DB_USERNAME=jaya
DB_PASSWORD=GANTI_PASSWORD_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Port di host. Lokal dari HP: APP_PORT_BIND=0.0.0.0
APP_PORT_BIND=127.0.0.1
APP_PORT=8000
