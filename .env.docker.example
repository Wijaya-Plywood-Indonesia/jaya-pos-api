# Salin menjadi .env di folder proyek, lalu isi yang bertanda GANTI
APP_NAME="Aplikasi POS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # GANTI: echo "base64:$(openssl rand -base64 32)"
APP_URL=http://103.56.148.45:8090   # nanti ganti ke https://domainmu setelah domain siap
JAYA_CONTACT_EMAIL=emailmu@domain.com

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=aplikasi_pos
DB_USERNAME=aplikasi
DB_PASSWORD=GANTI_PASSWORD_HURUF_ANGKA
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_HURUF_ANGKA

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Tahap IP: 0.0.0.0 supaya bisa dibuka dari HP. Setelah ada domain + proxy, kembalikan ke 127.0.0.1
APP_PORT_BIND=0.0.0.0
APP_PORT=8090
